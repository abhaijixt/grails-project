{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GRAILS_OPTS": "-Xms128m -Xmx768m -Dfile.encoding=UTF-8"
  },
  "permissions": {
    "allow": [
      "Bash(grails --non-interactive compile:*)",
      "Bash(grails --non-interactive clean:*)",
      "Bash(grails --non-interactive test-app:*)",
      "Bash(grails --non-interactive prod war:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(curl -s http://localhost:8080/health:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(.claude/hooks/test.sh:*)",
      "Bash(.claude/hooks/format.sh:*)",
      "Bash(.claude/hooks/validate.sh:*)",
      "Bash(.claude/hooks/escalate.sh:*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fdx:*)",
      "Bash(mysql:*)",
      "Bash(mariadb:*)",
      "Bash(mysqldump:*)",
      "Read(//home/abhaijixt/.config/bookstore/**)",
      "Read(//home/abhaijixt/.grails/bookstore-local.groovy)",
      "Read(./**/*.jks)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Edit(./target/**)",
      "Edit(./site/**)",
      "Edit(./.venv-docs/**)",
      "Edit(./web-app/WEB-INF/tld/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
